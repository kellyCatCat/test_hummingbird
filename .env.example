# SSH / 远程环境配置示例
# 复制成本地私有文件后 source，或直接 export 到当前 shell。
# 注意：不要把填好真实值的文件提交到仓库（.gitignore 已忽略 .env）。

# 右侧环境 ip，联系提交人获取
export SSH_HOST=
export SSH_PORT=22

# sopuser 登录账号密码
export SSH_USERNAME=sopuser
export SSH_PASSWORD=

# root 密码，用于 su 切换
export SSH_SU_PASSWORD=

# 调试日志开关，设为 0 关闭写文件
export SSH_DEBUG=1
